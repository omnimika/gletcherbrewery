# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling and logs
*.log
.tmp/

# hero bottle: only delivery encodes in public/; masters/work live under .tmp/
/public/vid/herobottle/masters/
/public/vid/herobottle/work/
/public/vid/herobottle/web/

# local drop zone for large source packs (moved selections live under assets/)
/tmp/
/assets/brand/fonts/**/*Trial*
/public/fonts/*Trial*

# Local agent design skills (Impeccable / Taste / Animation) — reinstall via
# docs/design/AGENT_DESIGN_SKILLS.md; not part of the product tree.
.agents/
.claude/agents/
.claude/skills/
.claude/settings.local.json
.cursor/agents/
.cursor/skills/
.cursor/hooks.json
.codex/
skills-lock.json
.taste-skill/
**/.taste-skill/

# docs partial ignore — policy: docs/README.md
# Keep public: adr/, design/, backend/, development.md, discovery baselines.
# Local-only: sprint queue, reviews, archive, raw dumps, brand PDF, sensitive
# inventory/migration/loyalty research, blog batch manifests, fixtures.
/docs/reviews/
/docs/archive/
/docs/discovery/_raw/
/docs/brand/**/*.pdf
/docs/CURSOR_NEXT_STEPS.md
/docs/CURSOR_REVIEW_PROMPT.md
/docs/SPRINT_PLAN.md
/docs/ROADMAP.md
/docs/discovery/BLOG_BATCH*_MANIFEST.md
/docs/data/fixtures/
/docs/data/SOURCE_INVENTORY.md
/docs/data/AIRTABLE_LOYALTY_SCHEMA.md
/docs/data/LOYALTY_WRITERS_MAP.md
/docs/data/LOYALTY_MIGRATION_PLAN.md
/docs/data/PRODUCT_GTIN_CATALOG.md
/docs/discovery/LOYALTY_OWNER_QUESTIONS.md
/docs/discovery/FNS_OPEN_API_APPLICATION_DRAFT.md
/docs/discovery/RECEIPT_FNS_PROVIDER_RESEARCH.md
/docs/discovery/INTEGRATIONS_AUDIT.md
/docs/discovery/MEMBERS_LK_INVENTORY.md
/docs/discovery/SITE_INVENTORY.md
/docs/discovery/CONTENT_SEO_INVENTORY.md