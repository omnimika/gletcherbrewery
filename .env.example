# На этапе инициализации переменные окружения не требуются.
# Не добавляйте реальные секреты в этот файл.

# Optional: local-only notes for authenticated discovery (never commit real values)
# MEMBERS_LK_EMAIL=
# MEMBERS_LK_PASSWORD=

# Optional CDN / Object Storage prefix for hero bottle media (no trailing slash)
# NEXT_PUBLIC_HERO_BOTTLE_BASE=https://files.gletcherbrewery.com/vid/herobottle

# Public Mapbox token for `/map` (pk.… only). Put the real value in `.env.local` — never commit it.
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.YOUR_PUBLIC_TOKEN

# SEO (Q3): opt-in public indexing. Preview/dev must stay false / unset.
# Robots.txt is not access control — protect previews with auth/network separately.
# ALLOW_SITE_INDEXING=true
# Optional absolute origin for sitemap/robots (default https://www.gletcherbrewery.com)
# NEXT_PUBLIC_SITE_ORIGIN=https://www.gletcherbrewery.com

# --- B1 forms / PostgreSQL / NocoDB (server-only; never NEXT_PUBLIC) ---
# Local non-prod: `npm run db:embedded` writes these into .env.local (default port 54329).
# Compose/Homebrew may use 5432 instead. Real secrets only in .env.local / secret store.
# DATABASE_URL=postgres://gletcher_app:gletcher_app_dev@127.0.0.1:54329/gletcher_business
# MIGRATION_DATABASE_URL=postgres://gletcher_migrator:gletcher_migrator_dev@127.0.0.1:54329/gletcher_business
# NOCODB_META_DATABASE_URL=postgres://gletcher_migrator:gletcher_migrator_dev@127.0.0.1:54329/nocodb_meta
# NOCODB_DATABASE_URL=postgres://gletcher_nocodb:gletcher_nocodb_dev@127.0.0.1:54329/gletcher_business
# PGPORT=54329
# B2 (not wired in B1):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_THREAD_ID=
# LEAD_SHEETS_SPREADSHEET_ID=
# LEAD_SHEETS_TAB=
# GOOGLE_SERVICE_ACCOUNT_JSON=
